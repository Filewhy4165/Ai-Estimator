# =============================================================================
# AI-Estimator Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values before running docker-compose.
#   cp .env.example .env

# -- Application --------------------------------------------------------------
APP_NAME=AI-Estimator
APP_VERSION=0.1.0

# -- Domain & Ports -----------------------------------------------------------
# Set to your real domain for auto-HTTPS via Caddy (e.g. estimator.example.com)
# Leave as localhost for local development (HTTP only)
DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443

# -- Database (PostgreSQL) ----------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_strong_db_password
# Full connection URL used by the API service
DATABASE_URL=postgresql://postgres:changeme_strong_db_password@postgres:5432/ai_estimator

# -- Redis --------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -- JWT / Authentication -----------------------------------------------------
# MUST be changed in production. Generate with: openssl rand -hex 32
JWT_SECRET=changeme_generate_a_random_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# -- Stripe (billing) ---------------------------------------------------------
# Leave empty to disable billing features
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# -- CORS ---------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:3000,http://localhost:3000

# -- Upload Limits ------------------------------------------------------------
UPLOAD_MAX_FILES=50
UPLOAD_MAX_SIZE_MB=100

# -- Rate Limiting ------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60

# -- API Key (legacy/simple auth) ---------------------------------------------
# If set, all non-health endpoints require X-API-Key header
AI_ESTIMATOR_API_KEY=

# -- Frontend -----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost/api
