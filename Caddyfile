# AI-Estimator Caddy Reverse Proxy Configuration
# ──────────────────────────────────────────────────────
# For local development, DOMAIN defaults to localhost
# (no auto-HTTPS). For production, set DOMAIN to your
# real hostname and Caddy provisions TLS automatically.

{$DOMAIN:localhost} {
    # ── API routes ──────────────────────────────────
    handle /api/* {
        reverse_proxy api:8000
    }

    handle /auth/* {
        reverse_proxy api:8000
    }

    # API docs & health (served at root of API)
    handle /docs* {
        reverse_proxy api:8000
    }

    handle /openapi.json {
        reverse_proxy api:8000
    }

    handle /health {
        reverse_proxy api:8000
    }

    # ── Frontend catch-all ──────────────────────────
    handle {
        reverse_proxy web:3000
    }

    # ── Security headers ────────────────────────────
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }

    # ── Logging ─────────────────────────────────────
    log {
        output stdout
        format console
    }
}
